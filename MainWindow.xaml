<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FantasyTools.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:FantasyTools.Views"
    Title="幻杀工具箱"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        IsTabStop="True"
        KeyboardAcceleratorPlacementMode="Hidden"
        Tapped="RootGrid_Tapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="18,0,170,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="7" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/AppIcon.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="幻杀工具箱"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding AppVersionText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView
            x:Name="ShellNavigation"
            Grid.Row="1"
            CompactPaneLength="64"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsSettingsVisible="False"
            OpenPaneLength="286"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="ShellNavigation_SelectionChanged"
            SelectionFollowsFocus="Disabled">
            <NavigationView.Resources>
                <x:Double x:Key="NavigationViewItemOnLeftMinHeight">64</x:Double>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="CharactersNavItem"
                    Content="角色"
                    IsSelected="True"
                    Tag="Characters">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="HandCardsNavItem"
                    Content="手牌"
                    Tag="HandCards">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="UnrealSyncNavItem"
                    Content="虚幻同步台"
                    Tag="UnrealSync">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Sync" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="GlobalSettingsNavItem"
                    Content="整体设置"
                    Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="20" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="CharactersPage" VerticalScrollBarVisibility="Auto">
                    <Grid HorizontalAlignment="Stretch" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="角色" />
                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="武将与角色卡的主工作区。卡片点击后进入角色编辑次级页。" />
                        </StackPanel>

                        <InfoBar
                            Grid.Row="1"
                            IsClosable="False"
                            IsOpen="True"
                            Message="当前阶段已固定角色主入口、工具栏和对象卡片样式；角色数据模型会在后续特化规范接入。"
                            Severity="Warning"
                            Title="角色工作区待接入" />

                        <Border x:Name="CharactersToolbar" Grid.Row="2" Style="{StaticResource ToolbarBorderStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    PlaceholderText="搜索角色 / 武将 / 代号 / Tag / 技能"
                                    Text="{Binding Characters.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="1"
                                    Click="OpenCharacterFilterButton_Click"
                                    Style="{StaticResource IconToolButtonStyle}"
                                    ToolTipService.ToolTip="筛选">
                                    <SymbolIcon Symbol="Filter" />
                                </Button>
                                <Button
                                    Grid.Column="2"
                                    Click="OpenCharacterSortButton_Click"
                                    Style="{StaticResource IconToolButtonStyle}"
                                    ToolTipService.ToolTip="{Binding Characters.SortSummary, Mode=OneWay}">
                                    <SymbolIcon Symbol="Sort" />
                                </Button>
                                <Button
                                    Grid.Column="3"
                                    Style="{StaticResource PrimaryToolButtonStyle}"
                                    ToolTipService.ToolTip="角色导入与导出">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Share" />
                                        <TextBlock Text="导入/导出" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="导入角色包" Click="ImportCharacterPackagesButton_Click">
                                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Download" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="导出角色" Click="ExportCharactersButton_Click">
                                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Upload" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="打开角色导出目录" Click="OpenCharacterExportFolderButton_Click">
                                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="OpenFile" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock
                                    Grid.Column="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SubtleTextStyle}"
                                    Text="{Binding Characters.FilterSummary, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <Border
                            x:Name="CharacterExportSelectionToolbar"
                            Grid.Row="2"
                            Style="{StaticResource ToolbarBorderStyle}"
                            Visibility="Collapsed">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    x:Name="CharacterExportSelectAllCheckBox"
                                    Click="CharacterExportSelectAllCheckBox_Click"
                                    Content="全选"
                                    IsThreeState="True"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="CharacterExportSelectedCountText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SubtleTextStyle}"
                                    Text="已选 0 / 0" />
                                <Button
                                    x:Name="ConfirmCharacterExportSelectionButton"
                                    Grid.Column="3"
                                    Click="ConfirmCharacterExportSelectionButton_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryToolButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Upload" />
                                        <TextBlock Text="导出所选" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="4"
                                    Click="CancelCharacterExportSelectionButton_Click"
                                    Content="取消"
                                    Style="{StaticResource PrimaryToolButtonStyle}" />
                            </Grid>
                        </Border>

                        <ItemsControl
                            Grid.Row="3"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Characters.Cards, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid
                                        HorizontalAlignment="Stretch"
                                        ItemHeight="242.4"
                                        ItemWidth="165.6"
                                        MaximumRowsOrColumns="8"
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="146.4" Height="220.8">
                                    <Button
                                        AutomationProperties.HelpText="按 Enter 打开角色卡，按 Shift+F10 打开菜单，按 Delete 打开删除确认。"
                                        AutomationProperties.Name="{Binding AutomationName, Mode=OneWay}"
                                        Click="CharacterCardButton_Click"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource StandardPlayingCardButtonStyle}"
                                        ContextRequested="CharacterCard_ContextRequested"
                                        KeyDown="CharacterCard_KeyDown"
                                        ToolTipService.ToolTip="{Binding AutomationName, Mode=OneWay}">
                                        <Grid
                                            VerticalAlignment="Top"
                                            Width="146.4"
                                            Height="220.8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="7.2" />
                                                <RowDefinition Height="185.4" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="1" Style="{StaticResource StandardPlayingCardFrameStyle}">
                                                <Border Style="{StaticResource StandardPlayingCardMediaStyle}">
                                                    <Border.Background>
                                                        <ImageBrush
                                                            AlignmentX="Center"
                                                            AlignmentY="Center"
                                                            ImageSource="{Binding CardFacePath, Converter={StaticResource FileImageSourceConverter}, Mode=OneWay}"
                                                            Stretch="UniformToFill" />
                                                    </Border.Background>
                                                    <Grid>
                                                        <Border
                                                            Width="32"
                                                            Height="32"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="16"
                                                            Opacity="0.94"
                                                            Visibility="{Binding IsAddCard, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                                            <FontIcon
                                                                FontSize="18"
                                                                Glyph="&#xE710;"
                                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Border>
                                            <TextBlock
                                                Grid.Row="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                LineHeight="16"
                                                MaxWidth="132"
                                                Text="{Binding DisplayName, Mode=OneWay}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{Binding IsAddCard, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}" />
                                        </Grid>
                                    </Button>
                                    <CheckBox
                                        Margin="0,14,14,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Canvas.ZIndex="2"
                                        AutomationProperties.Name="选择导出此角色"
                                        Checked="ExportCardCheckBox_Changed"
                                        IsChecked="{Binding IsExportSelected, Mode=TwoWay}"
                                        UseSystemFocusVisuals="False"
                                        Unchecked="ExportCardCheckBox_Changed"
                                        Visibility="{Binding IsExportSelectionVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <Grid
                    x:Name="CharacterDetailPage"
                    Visibility="Collapsed"
                    RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Click="BackToCharactersButton_Click"
                            Style="{StaticResource IconToolButtonStyle}"
                            ToolTipService.ToolTip="返回角色列表">
                            <SymbolIcon Symbol="Back" />
                        </Button>

                        <ScrollViewer
                            Grid.Column="1"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Click="BackToCharactersButton_Click"
                                    Content="{Binding CharacterDetail.BreadcrumbText, Mode=OneWay}"
                                    Style="{StaticResource SecondaryBreadcrumbButtonStyle}"
                                    ToolTipService.ToolTip="返回角色列表" />
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <Grid HorizontalAlignment="Stretch" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock
                                Style="{StaticResource PageTitleStyle}"
                                Text="{Binding CharacterDetail.Title, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource SubtleTextStyle}"
                                Text="{Binding CharacterDetail.Subtitle, Mode=OneWay}" />
                        </StackPanel>

                        <InfoBar
                            Grid.Row="1"
                            IsClosable="False"
                            IsOpen="{Binding CharacterDetail.IsNoticeOpen, Mode=OneWay}"
                            Message="{Binding CharacterDetail.NoticeMessage, Mode=OneWay}"
                            Severity="Warning"
                            Title="{Binding CharacterDetail.NoticeTitle, Mode=OneWay}" />

                        <Grid Grid.Row="2" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="360" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="16">
                                <Border Style="{StaticResource PanelBorderStyle}">
                                    <StackPanel Padding="16" Spacing="12">
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="基础资料" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                Header="角色英文代号"
                                                PlaceholderText="例如：Kirito / Akame"
                                                Text="{Binding CharacterDetail.CodeEditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button
                                                Grid.Column="1"
                                                Margin="0,28,0,0"
                                                Click="ApplyCharacterCodeButton_Click"
                                                Content="确定修改"
                                                Style="{StaticResource PrimaryToolButtonStyle}" />
                                        </Grid>
                                        <TextBox
                                            Header="中文名"
                                            PlaceholderText="例如：赤瞳 / 桐人；为空时对外显示英文代号"
                                            Text="{Binding CharacterDetail.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextChanged="CharacterDetailTextBox_TextChanged" />
                                        <TextBox
                                            Header="介绍"
                                            AcceptsReturn="True"
                                            MinHeight="116"
                                            PlaceholderText="角色背景、定位和玩法说明"
                                            Text="{Binding CharacterDetail.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextChanged="CharacterDetailTextBox_TextChanged"
                                            TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox
                                                Header="血量"
                                                AcceptsExpression="False"
                                                LargeChange="5"
                                                Minimum="1"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Compact"
                                                ValidationMode="InvalidInputOverwritten"
                                                Value="{Binding CharacterDetail.Health, Mode=TwoWay}"
                                                ValueChanged="CharacterDetailNumberBox_ValueChanged" />
                                            <NumberBox
                                                Grid.Column="1"
                                                Header="Stage（形态阶段）"
                                                AcceptsExpression="False"
                                                Minimum="1"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Compact"
                                                ValidationMode="InvalidInputOverwritten"
                                                Value="{Binding CharacterDetail.Phase, Mode=TwoWay}"
                                                ValueChanged="CharacterDetailNumberBox_ValueChanged" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PanelBorderStyle}">
                                    <StackPanel Padding="16" Spacing="12">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="携带技能组" />
                                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="英文代号按顺序自动生成，用户不可更改。" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Click="AddCharacterSkillButton_Click"
                                                Style="{StaticResource PrimaryToolButtonStyle}"
                                                ToolTipService.ToolTip="新增技能组">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <SymbolIcon Symbol="Add" />
                                                    <TextBlock Text="新增技能组" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding CharacterDetail.Skills, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="0,0,0,12"
                                                        Padding="14"
                                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8">
                                                        <Grid RowSpacing="10">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <Grid ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    FontSize="16"
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding Code, Mode=OneWay}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    VerticalAlignment="Center" />
                                                                <Button
                                                                    Grid.Column="1"
                                                                    Click="RemoveCharacterSkillButton_Click"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource CompactIconButtonStyle}"
                                                                    ToolTipService.ToolTip="删除技能">
                                                                    <SymbolIcon Symbol="Cancel" />
                                                                </Button>
                                                            </Grid>

                                                            <Grid Grid.Row="1" ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="220" />
                                                                    <ColumnDefinition Width="220" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox
                                                                    Header="名称"
                                                                    PlaceholderText="例如：迅影突袭"
                                                                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    TextChanged="CharacterDetailTextBox_TextChanged" />
                                                                <TextBox
                                                                    Grid.Column="1"
                                                                    Header="英文代号"
                                                                    IsReadOnly="True"
                                                                    Text="{Binding Code, Mode=OneWay}" />
                                                                <TextBox
                                                                    Grid.Column="2"
                                                                    Header="类型"
                                                                    PlaceholderText="例如：主动 / 被动 / 锁定"
                                                                    Text="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    TextChanged="CharacterDetailTextBox_TextChanged" />
                                                            </Grid>

                                                            <Grid Grid.Row="2" ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="280" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox
                                                                    Header="函数"
                                                                    PlaceholderText="例如：FSkillStart"
                                                                    Text="{Binding Function, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    TextChanged="CharacterDetailTextBox_TextChanged" />
                                                                <TextBox
                                                                    Grid.Column="1"
                                                                    Header="技能介绍"
                                                                    AcceptsReturn="True"
                                                                    MinHeight="92"
                                                                    PlaceholderText="填写技能效果、触发条件和限制"
                                                                    Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    TextChanged="CharacterDetailTextBox_TextChanged"
                                                                    TextWrapping="Wrap" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource PanelBorderStyle}">
                                        <StackPanel Padding="16" Spacing="10">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Tag 合集" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Click="AddCharacterTagButton_Click" Style="{StaticResource CompactIconButtonStyle}" ToolTipService.ToolTip="添加 Tag">
                                                    <SymbolIcon Symbol="Add" />
                                                </Button>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding CharacterDetail.Tags, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox
                                                                PlaceholderText="例如：主角 / 近战 / 暗伤"
                                                                Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                TextChanged="CharacterDetailTextBox_TextChanged" />
                                                            <Button
                                                                Grid.Column="1"
                                                                Click="RemoveCharacterTagButton_Click"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource CompactIconButtonStyle}"
                                                                ToolTipService.ToolTip="删除 Tag">
                                                                <SymbolIcon Symbol="Cancel" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                                        <StackPanel Padding="16" Spacing="10">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="携带牌" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Click="AddCharacterCarryCardButton_Click" Style="{StaticResource CompactIconButtonStyle}" ToolTipService.ToolTip="添加携带牌">
                                                    <SymbolIcon Symbol="Add" />
                                                </Button>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding CharacterDetail.CarryCards, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox
                                                                PlaceholderText="例如：武器牌：阐释者(1)"
                                                                Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                TextChanged="CharacterDetailTextBox_TextChanged" />
                                                            <Button
                                                                Grid.Column="1"
                                                                Click="RemoveCharacterCarryCardButton_Click"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource CompactIconButtonStyle}"
                                                                ToolTipService.ToolTip="删除携带牌">
                                                                <SymbolIcon Symbol="Cancel" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="16">
                                <Border Style="{StaticResource PanelBorderStyle}">
                                    <StackPanel Padding="16" Spacing="12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="角色卡面" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource SubtleTextStyle}"
                                                Text="{Binding CharacterDetail.LastUpdatedText, Mode=OneWay}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                        <Button
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            Click="ChooseCharacterCardFaceButton_Click"
                                            ToolTipService.ToolTip="设置角色卡面，目标尺寸 732x1028">
                                            <Border
                                                Width="220"
                                                Height="309"
                                                CornerRadius="8">
                                                <Image
                                                    x:Name="CharacterCardFacePreviewImage"
                                                    Width="220"
                                                    Height="309"
                                                    Stretch="UniformToFill" />
                                            </Border>
                                        </Button>
                                        <TextBlock Style="{StaticResource SubtleTextStyle}" Text="点击卡面设置图片；目标尺寸 732x1028，会弹出裁剪确认。" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <ScrollViewer
                    x:Name="HandCardsPage"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto">
                    <Grid HorizontalAlignment="Stretch" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="手牌" />
                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="卡牌制作入口。按三国杀类卡牌比例预留基础牌、锦囊牌、装备牌与卡面素材区。" />
                        </StackPanel>

                        <InfoBar
                            Grid.Row="1"
                            IsClosable="False"
                            IsOpen="True"
                            Message="{Binding HandCards.HandCardsNoticeMessage, Mode=OneWay}"
                            Severity="{Binding HandCards.HandCardsNoticeSeverity, Mode=OneWay}"
                            Title="{Binding HandCards.HandCardsNoticeTitle, Mode=OneWay}" />

                        <Border x:Name="HandCardsToolbar" Grid.Row="2" Style="{StaticResource ToolbarBorderStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    PlaceholderText="搜索手牌 / 代号"
                                    Text="{Binding HandCards.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="1"
                                    Click="OpenHandCardFilterButton_Click"
                                    Style="{StaticResource IconToolButtonStyle}"
                                    ToolTipService.ToolTip="筛选">
                                    <SymbolIcon Symbol="Filter" />
                                </Button>
                                <Button
                                    Grid.Column="2"
                                    Click="OpenHandCardSortButton_Click"
                                    Style="{StaticResource IconToolButtonStyle}"
                                    ToolTipService.ToolTip="{Binding HandCards.SortSummary, Mode=OneWay}">
                                    <SymbolIcon Symbol="Sort" />
                                </Button>
                                <Button
                                    Grid.Column="3"
                                    Click="OpenBasicDeckSettingsButton_Click"
                                    Style="{StaticResource PrimaryToolButtonStyle}"
                                    ToolTipService.ToolTip="打开牌堆设置">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="AllApps" />
                                        <TextBlock Text="牌堆设置" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="4"
                                    Style="{StaticResource PrimaryToolButtonStyle}"
                                    ToolTipService.ToolTip="手牌导入与导出">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Share" />
                                        <TextBlock Text="导入/导出" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="导入手牌包" Click="ImportHandCardPackagesButton_Click">
                                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Download" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="从其他项目导入手牌" Click="ImportHandCardsFromProjectButton_Click">
                                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Folder" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="导出手牌" Click="ExportHandCardsButton_Click">
                                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Upload" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="打开手牌导出目录" Click="OpenHandCardExportFolderButton_Click">
                                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="OpenFile" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock
                                    Grid.Column="5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SubtleTextStyle}"
                                    Text="{Binding HandCards.FilterSummary, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <Border
                            x:Name="HandCardExportSelectionToolbar"
                            Grid.Row="2"
                            Style="{StaticResource ToolbarBorderStyle}"
                            Visibility="Collapsed">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    x:Name="HandCardExportSelectAllCheckBox"
                                    Click="HandCardExportSelectAllCheckBox_Click"
                                    Content="全选"
                                    IsThreeState="True"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="HandCardExportSelectedCountText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SubtleTextStyle}"
                                    Text="已选 0 / 0" />
                                <Button
                                    x:Name="ConfirmHandCardExportSelectionButton"
                                    Grid.Column="3"
                                    Click="ConfirmHandCardExportSelectionButton_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryToolButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Upload" />
                                        <TextBlock Text="导出所选" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="4"
                                    Click="CancelHandCardExportSelectionButton_Click"
                                    Content="取消"
                                    Style="{StaticResource PrimaryToolButtonStyle}" />
                            </Grid>
                        </Border>

                        <ItemsControl
                            Grid.Row="3"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding HandCards.Cards, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid
                                        HorizontalAlignment="Stretch"
                                        ItemHeight="242.4"
                                        ItemWidth="165.6"
                                        MaximumRowsOrColumns="8"
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="146.4" Height="220.8">
                                    <Button
                                        AutomationProperties.HelpText="按 Enter 打开手牌卡。"
                                        AutomationProperties.Name="{Binding AutomationName, Mode=OneWay}"
                                        Click="HandCardButton_Click"
                                        CommandParameter="{Binding}"
                                        ContextRequested="HandCard_ContextRequested"
                                        KeyDown="HandCard_KeyDown"
                                        Style="{StaticResource StandardPlayingCardButtonStyle}"
                                        ToolTipService.ToolTip="{Binding AutomationName, Mode=OneWay}">
                                        <Button.Background>
                                            <Binding Converter="{StaticResource HandCardSuitBrushConverter}" ConverterParameter="Background" Mode="OneWay" />
                                        </Button.Background>
                                        <Grid
                                            VerticalAlignment="Top"
                                            Width="146.4"
                                            Height="220.8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="7.2" />
                                                <RowDefinition Height="185.4" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="1" Style="{StaticResource StandardPlayingCardFrameStyle}">
                                                <Border Style="{StaticResource StandardPlayingCardMediaStyle}">
                                                    <Grid>
                                                        <Border
                                                            Background="{Binding Converter={StaticResource HandCardSuitBrushConverter}, ConverterParameter=Background, Mode=OneWay}"
                                                            CornerRadius="8" />
                                                        <Border
                                                            CornerRadius="8">
                                                            <Border.Background>
                                                                <ImageBrush
                                                                    AlignmentX="Center"
                                                                    AlignmentY="Center"
                                                                    ImageSource="{Binding CardFacePath, Converter={StaticResource FileImageSourceConverter}, Mode=OneWay}"
                                                                    Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                        <StackPanel
                                                            Margin="7,5,0,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Spacing="-2"
                                                            Visibility="{Binding IsAddCard, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                                                            <views:OutlinedTextBlock
                                                                FontSize="15"
                                                                Foreground="{Binding Converter={StaticResource HandCardSuitBrushConverter}, ConverterParameter=Text, Mode=OneWay}"
                                                                Stroke="{ThemeResource HandCardSuitTextStrokeBrush}"
                                                                Text="{Binding PokerNumberLabel, Mode=OneWay}" />
                                                            <views:OutlinedTextBlock
                                                                FontSize="15"
                                                                Foreground="{Binding Converter={StaticResource HandCardSuitBrushConverter}, ConverterParameter=Text, Mode=OneWay}"
                                                                Stroke="{ThemeResource HandCardSuitTextStrokeBrush}"
                                                                Text="{Binding SuitSymbol, Mode=OneWay}" />
                                                        </StackPanel>
                                                        <StackPanel
                                                            Margin="0,0,7,5"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            RenderTransformOrigin="0.5,0.5"
                                                            Spacing="-2"
                                                            Visibility="{Binding IsAddCard, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                                                            <StackPanel.RenderTransform>
                                                                <RotateTransform Angle="180" />
                                                            </StackPanel.RenderTransform>
                                                            <views:OutlinedTextBlock
                                                                FontSize="15"
                                                                Foreground="{Binding Converter={StaticResource HandCardSuitBrushConverter}, ConverterParameter=Text, Mode=OneWay}"
                                                                Stroke="{ThemeResource HandCardSuitTextStrokeBrush}"
                                                                Text="{Binding PokerNumberLabel, Mode=OneWay}" />
                                                            <views:OutlinedTextBlock
                                                                FontSize="15"
                                                                Foreground="{Binding Converter={StaticResource HandCardSuitBrushConverter}, ConverterParameter=Text, Mode=OneWay}"
                                                                Stroke="{ThemeResource HandCardSuitTextStrokeBrush}"
                                                                Text="{Binding SuitSymbol, Mode=OneWay}" />
                                                        </StackPanel>
                                                        <Border
                                                            Width="32"
                                                            Height="32"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="16"
                                                            Opacity="0.94"
                                                            Visibility="{Binding IsAddCard, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                                            <FontIcon
                                                                FontSize="18"
                                                                Glyph="&#xE710;"
                                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Border>
                                            <TextBlock
                                                Grid.Row="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                LineHeight="16"
                                                MaxWidth="132"
                                                Text="{Binding DisplayName, Mode=OneWay}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{Binding IsAddCard, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}" />
                                        </Grid>
                                    </Button>
                                    <CheckBox
                                        Margin="0,14,14,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Canvas.ZIndex="2"
                                        AutomationProperties.Name="选择导出此手牌"
                                        Checked="ExportCardCheckBox_Changed"
                                        IsChecked="{Binding IsExportSelected, Mode=TwoWay}"
                                        UseSystemFocusVisuals="False"
                                        Unchecked="ExportCardCheckBox_Changed"
                                        Visibility="{Binding IsExportSelectionVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <Grid
                    x:Name="BasicDeckSettingsPage"
                    Visibility="Collapsed"
                    RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Click="BackToHandCardsButton_Click"
                            Style="{StaticResource IconToolButtonStyle}"
                            ToolTipService.ToolTip="返回手牌列表">
                            <SymbolIcon Symbol="Back" />
                        </Button>

                        <ScrollViewer
                            Grid.Column="1"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Click="BackToHandCardsListButton_Click"
                                    Content="手牌"
                                    Style="{StaticResource SecondaryBreadcrumbButtonStyle}"
                                    ToolTipService.ToolTip="返回手牌列表" />
                                <SymbolIcon
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Symbol="Forward" />
                                <Button
                                    Content="牌堆设置"
                                    Style="{StaticResource SecondaryBreadcrumbButtonStyle}"
                                    ToolTipService.ToolTip="当前页面" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid HorizontalAlignment="Stretch" RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource PageTitleStyle}" Text="牌堆设置" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding HandCards.SuitDeckSummary, Mode=OneWay}" />
                                <ComboBox
                                    Width="220"
                                    HorizontalAlignment="Left"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding HandCards.SuitDeckGroups, Mode=OneWay}"
                                    SelectedItem="{Binding HandCards.SelectedSuitDeckGroup, Mode=TwoWay}" />
                            </StackPanel>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding HandCards.SelectedSuitDeckGroup.SuitGroups, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14" Spacing="8">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="{Binding DisplayName, Mode=OneWay}" />
                                            <ItemsControl ItemsSource="{Binding Slots, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ItemsWrapGrid
                                                            HorizontalAlignment="Stretch"
                                                            ItemHeight="134"
                                                            ItemWidth="350"
                                                            MaximumRowsOrColumns="4"
                                                            Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Width="332"
                                                            Height="118"
                                                            Padding="0"
                                                            BorderBrush="{Binding IsFilled, Converter={StaticResource SuitDeckSlotBrushConverter}, ConverterParameter=Border, Mode=OneWay}"
                                                            BorderThickness="1"
                                                            Background="{Binding IsFilled, Converter={StaticResource SuitDeckSlotBrushConverter}, ConverterParameter=Background, Mode=OneWay}"
                                                            CornerRadius="8">
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="82" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <Grid
                                                                    Padding="12"
                                                                    Background="{Binding IsFilled, Converter={StaticResource SuitDeckSlotBrushConverter}, ConverterParameter=Accent, Mode=OneWay}">
                                                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                                                        <TextBlock
                                                                            FontSize="13"
                                                                            Foreground="{Binding IsFilled, Converter={StaticResource SuitDeckSlotBrushConverter}, ConverterParameter=AccentText, Mode=OneWay}"
                                                                            Text="{Binding SuitDisplayName, Mode=OneWay}"
                                                                            TextAlignment="Center" />
                                                                        <TextBlock
                                                                            FontSize="28"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{Binding IsFilled, Converter={StaticResource SuitDeckSlotBrushConverter}, ConverterParameter=AccentText, Mode=OneWay}"
                                                                            Text="{Binding NumberLabel, Mode=OneWay}"
                                                                            TextAlignment="Center" />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    MinWidth="0"
                                                                    Padding="0,12,0,12"
                                                                    VerticalAlignment="Stretch"
                                                                    Spacing="5">
                                                                    <TextBlock
                                                                        FontSize="15"
                                                                        FontWeight="SemiBold"
                                                                        Text="{Binding BindingTitle, Mode=OneWay}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{Binding BindingSubtitle, Mode=OneWay}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <Border
                                                                        HorizontalAlignment="Left"
                                                                        Padding="8,3"
                                                                        Background="{Binding IsFilled, Converter={StaticResource SuitDeckSlotBrushConverter}, ConverterParameter=BadgeBackground, Mode=OneWay}"
                                                                        BorderBrush="{Binding IsFilled, Converter={StaticResource SuitDeckSlotBrushConverter}, ConverterParameter=BadgeBorder, Mode=OneWay}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="4">
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="{Binding IsFilled, Converter={StaticResource SuitDeckSlotBrushConverter}, ConverterParameter=BadgeText, Mode=OneWay}"
                                                                            Text="{Binding StatusText, Mode=OneWay}" />
                                                                    </Border>
                                                                </StackPanel>

                                                                <Grid
                                                                    Grid.Column="2"
                                                                    Padding="0,0,12,0"
                                                                    VerticalAlignment="Center">
                                                                    <StackPanel Spacing="8">
                                                                        <Button
                                                                            Click="BasicDeckSlotButton_Click"
                                                                            CommandParameter="{Binding}"
                                                                            Content="{Binding SlotActionText, Mode=OneWay}"
                                                                            Style="{StaticResource PrimaryToolButtonStyle}" />
                                                                        <Button
                                                                            Click="ChangeBasicDeckSlotButton_Click"
                                                                            CommandParameter="{Binding}"
                                                                            Content="更改"
                                                                            Style="{StaticResource PrimaryToolButtonStyle}"
                                                                            Visibility="{Binding IsFilled, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid
                    x:Name="HandCardDetailPage"
                    Visibility="Collapsed"
                    RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Click="BackToHandCardsButton_Click"
                            Style="{StaticResource IconToolButtonStyle}"
                            ToolTipService.ToolTip="返回上一级">
                            <SymbolIcon Symbol="Back" />
                        </Button>

                        <ScrollViewer
                            Grid.Column="1"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Click="BackToHandCardsListButton_Click"
                                    Content="手牌"
                                    Style="{StaticResource SecondaryBreadcrumbButtonStyle}"
                                    ToolTipService.ToolTip="返回手牌列表" />
                                <SymbolIcon
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Symbol="Forward" />
                                <Button
                                    Click="BackToBasicDeckSettingsButton_Click"
                                    Content="牌堆设置"
                                    Style="{StaticResource SecondaryBreadcrumbButtonStyle}"
                                    ToolTipService.ToolTip="返回牌堆设置"
                                    Visibility="{Binding HandCardDetail.ShowBasicDeckBreadcrumb, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                <SymbolIcon
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Symbol="Forward"
                                    Visibility="{Binding HandCardDetail.ShowBasicDeckBreadcrumb, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                <Button
                                    Content="{Binding HandCardDetail.DetailBreadcrumbText, Mode=OneWay}"
                                    Style="{StaticResource SecondaryBreadcrumbButtonStyle}"
                                    ToolTipService.ToolTip="当前手牌详情" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <Grid HorizontalAlignment="Stretch" RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock
                                    Foreground="{Binding HandCardDetail.Suit, Converter={StaticResource HandCardSuitBrushConverter}, ConverterParameter=Text, Mode=OneWay}"
                                    Style="{StaticResource PageTitleStyle}"
                                    Text="{Binding HandCardDetail.Title, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource SubtleTextStyle}"
                                    Text="{Binding HandCardDetail.Subtitle, Mode=OneWay}" />
                            </StackPanel>

                            <InfoBar
                                Grid.Row="1"
                                IsClosable="False"
                                IsOpen="{Binding HandCardDetail.IsNoticeOpen, Mode=OneWay}"
                                Message="{Binding HandCardDetail.NoticeMessage, Mode=OneWay}"
                                Severity="Warning"
                                Title="{Binding HandCardDetail.NoticeTitle, Mode=OneWay}" />

                            <Grid Grid.Row="2" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="16">
                                    <Border Style="{StaticResource PanelBorderStyle}">
                                        <StackPanel Padding="16" Spacing="12">
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="基础资料" />
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    Header="手牌英文代号"
                                                    PlaceholderText="例如：Sha / Shan / QingGangSword"
                                                    Text="{Binding HandCardDetail.CodeEditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Margin="0,28,0,0"
                                                    Click="ApplyHandCardCodeButton_Click"
                                                    Content="确定修改"
                                                    Style="{StaticResource PrimaryToolButtonStyle}" />
                                            </Grid>
                                            <TextBox
                                                Header="名称"
                                                PlaceholderText="例如：杀 / 闪 / 青釭剑；为空时对外显示英文代号"
                                                Text="{Binding HandCardDetail.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextChanged="HandCardDetailTextBox_TextChanged" />
                                            <TextBox
                                                Header="介绍"
                                                AcceptsReturn="True"
                                                MinHeight="116"
                                                PlaceholderText="手牌效果、使用限制和玩法说明"
                                                Text="{Binding HandCardDetail.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextChanged="HandCardDetailTextBox_TextChanged"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource PanelBorderStyle}">
                                        <Grid Padding="16" ColumnSpacing="12" RowSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.ColumnSpan="2" Style="{StaticResource SectionTitleStyle}" Text="卡牌属性" />
                                            <ComboBox
                                                Grid.Row="1"
                                                Header="花色"
                                                DisplayMemberPath="DisplayName"
                                                IsEnabled="{Binding HandCardDetail.CanEditPokerIdentity, Mode=OneWay}"
                                                ItemsSource="{Binding HandCardDetail.Suits, Mode=OneWay}"
                                                SelectedValue="{Binding HandCardDetail.Suit, Mode=TwoWay}"
                                                SelectedValuePath="Value"
                                                SelectionChanged="HandCardDetailComboBox_SelectionChanged" />
                                            <NumberBox
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Header="扑克数字"
                                                AcceptsExpression="False"
                                                LargeChange="1"
                                                Maximum="13"
                                                Minimum="1"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Compact"
                                                IsEnabled="{Binding HandCardDetail.CanEditPokerIdentity, Mode=OneWay}"
                                                ValidationMode="InvalidInputOverwritten"
                                                Value="{Binding HandCardDetail.PokerNumber, Mode=TwoWay}"
                                                ValueChanged="HandCardDetailNumberBox_ValueChanged" />
                                            <InfoBar
                                                Grid.Row="2"
                                                Grid.ColumnSpan="2"
                                                IsClosable="False"
                                                IsOpen="{Binding HandCardDetail.IsBasicDeckLocked, Mode=OneWay}"
                                                Message="{Binding HandCardDetail.BasicDeckLockMessage, Mode=OneWay}"
                                                Severity="Warning"
                                                Title="牌堆已锁定花色和数字" />
                                            <ComboBox
                                                Grid.Row="3"
                                                Header="卡牌类型"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding HandCardDetail.CardTypes, Mode=OneWay}"
                                                SelectedValue="{Binding HandCardDetail.CardType, Mode=TwoWay}"
                                                SelectedValuePath="Value"
                                                SelectionChanged="HandCardDetailComboBox_SelectionChanged" />
                                            <NumberBox
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                Header="剩余使用次数"
                                                AcceptsExpression="False"
                                                LargeChange="1"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Compact"
                                                ValidationMode="InvalidInputOverwritten"
                                                Value="{Binding HandCardDetail.RemainingUseCount, Mode=TwoWay}"
                                                ValueChanged="HandCardDetailNumberBox_ValueChanged" />
                                            <ComboBox
                                                Grid.Row="4"
                                                Header="装备类型"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding HandCardDetail.EquipTypes, Mode=OneWay}"
                                                SelectedValue="{Binding HandCardDetail.EquipType, Mode=TwoWay}"
                                                SelectedValuePath="Value"
                                                SelectionChanged="HandCardDetailComboBox_SelectionChanged" />
                                            <NumberBox
                                                Grid.Row="4"
                                                Grid.Column="1"
                                                Header="数值（攻击范围/固定减伤）"
                                                AcceptsExpression="False"
                                                LargeChange="1"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Compact"
                                                ValidationMode="InvalidInputOverwritten"
                                                Value="{Binding HandCardDetail.Value, Mode=TwoWay}"
                                                ValueChanged="HandCardDetailNumberBox_ValueChanged" />
                                        </Grid>
                                    </Border>

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource PanelBorderStyle}">
                                            <StackPanel Padding="16" Spacing="10">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="函数组" VerticalAlignment="Center" />
                                                    <Button Grid.Column="1" Click="AddHandCardFunctionGroupButton_Click" Style="{StaticResource CompactIconButtonStyle}" ToolTipService.ToolTip="添加函数">
                                                        <SymbolIcon Symbol="Add" />
                                                    </Button>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding HandCardDetail.FunctionGroups, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox
                                                                    PlaceholderText="例如：BP_Card_Sha_Use"
                                                                    Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    TextChanged="HandCardDetailTextBox_TextChanged" />
                                                                <Button
                                                                    Grid.Column="1"
                                                                    Click="RemoveHandCardFunctionGroupButton_Click"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource CompactIconButtonStyle}"
                                                                    ToolTipService.ToolTip="删除函数">
                                                                    <SymbolIcon Symbol="Cancel" />
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                                            <StackPanel Padding="16" Spacing="12">
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="共鸣牌表达式" />
                                                <TextBox
                                                    Header="共鸣牌表达式"
                                                    AcceptsReturn="True"
                                                    MinHeight="156"
                                                    PlaceholderText="例如：A+B*2；用于后续同步到 FCardStruct.Expression"
                                                    Text="{Binding HandCardDetail.Expression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TextChanged="HandCardDetailTextBox_TextChanged"
                                                    TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="共鸣牌表达式用于下注公式，和装备数值没有优先级关系；后续可在同步阶段补充语法校验。" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="16">
                                    <Border Style="{StaticResource PanelBorderStyle}">
                                        <StackPanel Padding="16" Spacing="12">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="手牌卡面" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Style="{StaticResource SubtleTextStyle}"
                                                    Text="{Binding HandCardDetail.LastUpdatedText, Mode=OneWay}"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                            <Button
                                                Padding="0"
                                                HorizontalAlignment="Center"
                                                Click="ChooseHandCardFaceButton_Click"
                                                ToolTipService.ToolTip="设置手牌卡面，目标尺寸 357x300">
                                                <Border
                                                    Width="300"
                                                    Height="252"
                                                    CornerRadius="8">
                                                    <Image
                                                        x:Name="HandCardFacePreviewImage"
                                                        Width="300"
                                                        Height="252"
                                                        Stretch="UniformToFill" />
                                                </Border>
                                            </Button>
                                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="点击卡面设置图片；目标尺寸 357x300，会弹出裁剪确认。" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource PanelBorderStyle}">
                                        <StackPanel Padding="16" Spacing="8">
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="保存状态" />
                                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding HandCardDetail.SaveStatusText, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="字段对应 FantasyProject 的 FCardStruct：Name、Background/CardFace、Description、Poker、Number、Type、FunctionGroup、CanUseTimes、EquipType、EXValue、Expression；EXValue 中武器表示攻击范围，防具表示固定减伤。" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <ScrollViewer
                    x:Name="UnrealSyncPage"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto">
                    <Grid HorizontalAlignment="Stretch" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="虚幻同步台" />
                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="面向 FantasyProject 的同步入口。先记录引擎和项目路径，后续接入卡牌、角色、素材与 DataAsset/DataTable 同步。" />
                        </StackPanel>

                        <InfoBar
                            Grid.Row="1"
                            IsClosable="False"
                            IsOpen="True"
                            Message="同步前请先确认 Unreal Engine 路径和 Unreal 项目路径。后续执行同步时必须先备份或明确选择直接同步。"
                            Severity="Warning"
                            Title="等待同步定位" />

                        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                            <StackPanel Padding="16" Spacing="12">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="路径" />
                                <TextBox Header="Unreal Engine 路径" Text="{Binding Settings.UnrealEnginePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Header="Unreal 项目路径" PlaceholderText="D:\UnrealMap\FantasyProject\FantasyProject.uproject" Text="{Binding Settings.UnrealProjectPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="3" HorizontalAlignment="Center" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="236" />
                                <ColumnDefinition Width="236" />
                                <ColumnDefinition Width="236" />
                            </Grid.ColumnDefinitions>

                            <Button AutomationProperties.Name="检查虚幻项目路径" Style="{StaticResource ObjectCardStyle}">
                                <Border Width="220" Height="220" Padding="12" Style="{StaticResource PanelBorderStyle}">
                                    <StackPanel Spacing="8">
                                        <Border Style="{StaticResource ObjectCardMediaStyle}">
                                            <SymbolIcon Symbol="Find" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="检查项目" />
                                        <TextBlock Style="{StaticResource SubtleTextStyle}" Text="uproject / 插件 / 内容目录" />
                                        <TextBlock Style="{StaticResource SubtleTextStyle}" Text="不会弹无意义 Tips" />
                                    </StackPanel>
                                </Border>
                            </Button>

                            <Button Grid.Column="1" AutomationProperties.Name="同步角色" Style="{StaticResource ObjectCardStyle}">
                                <Border Width="220" Height="220" Padding="12" Style="{StaticResource PanelBorderStyle}">
                                    <StackPanel Spacing="8">
                                        <Border Style="{StaticResource ObjectCardMediaStyle}">
                                            <SymbolIcon Symbol="Contact" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="同步角色" />
                                        <TextBlock Style="{StaticResource SubtleTextStyle}" Text="武将资料 / 技能 / 素材" />
                                        <Border HorizontalAlignment="Left" Style="{StaticResource StatusPillBorderStyle}">
                                            <TextBlock Text="备份并同步" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <Button Grid.Column="2" AutomationProperties.Name="同步手牌" Style="{StaticResource ObjectCardStyle}">
                                <Border Width="220" Height="220" Padding="12" Style="{StaticResource PanelBorderStyle}">
                                    <StackPanel Spacing="8">
                                        <Border Style="{StaticResource ObjectCardMediaStyle}">
                                            <SymbolIcon Symbol="Library" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="同步手牌" />
                                        <TextBlock Style="{StaticResource SubtleTextStyle}" Text="卡牌定义 / 卡面素材" />
                                        <Border HorizontalAlignment="Left" Style="{StaticResource StatusPillBorderStyle}">
                                            <TextBlock Text="备份并同步" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="SettingsPage"
                    HorizontalScrollBarVisibility="Disabled"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto">
                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="16" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="整体设置" />
                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="这些设置影响所有项目。程序启动时会先检查整体项目位置，不存在则自动创建。" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="12">
                            <Border Style="{StaticResource PanelBorderStyle}">
                                <StackPanel Padding="16" Spacing="12">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="夜间模式" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="主题模式" />
                                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="默认浅色；切换后立即生效并保存。" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="ThemePreferenceComboBox"
                                            Grid.Column="1"
                                            MinWidth="160"
                                            SelectionChanged="ThemePreferenceComboBox_SelectionChanged"
                                            VerticalAlignment="Center">
                                            <ComboBoxItem Content="浅色" />
                                            <ComboBoxItem Content="跟随系统" />
                                            <ComboBoxItem Content="深色" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelBorderStyle}">
                                <StackPanel Padding="16" Spacing="12">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="整体项目位置" />
                                    <TextBlock Style="{StaticResource SubtleTextStyle}" Text="默认在 D 盘创建幻杀工具箱项目。settings、Logs、Backups 都放在这个整体项目目录中。" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Header="整体项目目录" IsReadOnly="True" Text="{Binding Settings.ProjectRootPath, Mode=OneWay}" />
                                        <Button Grid.Column="1" Margin="0,28,0,0" Click="ChooseProjectRootButton_Click" Content="选择位置" Style="{StaticResource PrimaryToolButtonStyle}" />
                                    </Grid>
                                    <InfoBar
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="{Binding Settings.ProjectRootStatusMessage, Mode=OneWay}"
                                        Severity="{Binding Settings.ProjectRootStatusSeverity, Mode=OneWay}"
                                        Title="{Binding Settings.ProjectRootStatusTitle, Mode=OneWay}" />
                                    <TextBox Header="settings 文件" IsReadOnly="True" Text="{Binding Settings.SettingsFilePath, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Expander>
                                <Expander.Header>
                                    <TextBlock FontWeight="SemiBold" Text="辅助显示" />
                                </Expander.Header>
                                <StackPanel Padding="16,8,16,16" Spacing="10">
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="显示工作区路径" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" IsOn="{Binding Settings.ShowWorkspacePath, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="显示当前模块说明" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" IsOn="{Binding Settings.ShowCurrentModule, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander>
                                <Expander.Header>
                                    <TextBlock FontWeight="SemiBold" Text="视觉显示" />
                                </Expander.Header>
                                <StackPanel Padding="16,8,16,16" Spacing="10">
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="手牌按花色显示底色" />
                                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="红桃红色、方片橙色、梅花青色、黑桃蓝色；默认开启。" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{Binding Settings.UseSuitColoredHandCards, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander>
                                <Expander.Header>
                                    <TextBlock FontWeight="SemiBold" Text="Log 输出" />
                                </Expander.Header>
                                <StackPanel Padding="16,8,16,16" Spacing="10">
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="开启 Log 功能" />
                                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="[HH:mm:ss] LogFantasyTools: Verbosity: Message" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{Binding Settings.LogEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="保存 Log 到文件" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" IsEnabled="{Binding Settings.IsLogOptionsEnabled, Mode=OneWay}" IsOn="{Binding Settings.LogSaveToFileEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                    <CheckBox Content="Log 输出用户操作" IsChecked="{Binding Settings.LogUserOperations, Mode=TwoWay}" IsEnabled="{Binding Settings.IsLogOptionsEnabled, Mode=OneWay}" />
                                    <CheckBox Content="Log 输出提示" IsChecked="{Binding Settings.LogWarnings, Mode=TwoWay}" IsEnabled="{Binding Settings.IsLogOptionsEnabled, Mode=OneWay}" />
                                    <CheckBox Content="Log 输出错误提示" IsChecked="{Binding Settings.LogErrors, Mode=TwoWay}" IsEnabled="{Binding Settings.IsLogOptionsEnabled, Mode=OneWay}" />
                                    <TextBox Header="Log 保存目录" IsReadOnly="True" Text="{Binding Settings.LogDirectoryPath, Mode=OneWay}" />
                                    <Button HorizontalAlignment="Left" Click="ClearLogButton_Click" Content="清空当前 Log" Style="{StaticResource PrimaryToolButtonStyle}" />
                                </StackPanel>
                            </Expander>

                            <Expander>
                                <Expander.Header>
                                    <TextBlock FontWeight="SemiBold" Text="快捷帮助" />
                                </Expander.Header>
                                <StackPanel Padding="16,8,16,16" Spacing="8">
                                    <TextBlock Text="F1：快捷键大全 / 帮助集合" />
                                    <TextBlock Text="F2：当前页面介绍和填写规则" />
                                    <TextBlock Style="{StaticResource SubtleTextStyle}" Text="快捷帮助已接入全局快捷键；设置页按 F1 显示设置 Tips。" />
                                </StackPanel>
                            </Expander>

                            <Expander>
                                <Expander.Header>
                                    <TextBlock FontWeight="SemiBold" Text="数据维护" />
                                </Expander.Header>
                                <StackPanel Padding="16,8,16,16" Spacing="8">
                                    <TextBox Header="备份目录" IsReadOnly="True" Text="{Binding Settings.BackupDirectoryPath, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource SubtleTextStyle}" Text="备份数量、pinned 备份和 Unreal 同步备份清理会在备份规范阶段接入。" />
                                </StackPanel>
                            </Expander>

                            <Expander>
                                <Expander.Header>
                                    <TextBlock FontWeight="SemiBold" Text="热更新" />
                                </Expander.Header>
                                <StackPanel Padding="16,8,16,16" Spacing="10">
                                    <TextBlock Style="{StaticResource SubtleTextStyle}" Text="WinUI 内检查、下载和校验；最终覆盖由可见 PowerShell updater 完成。" />
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="更新源" />
                                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding Settings.UpdateSourceText, Mode=OneWay}" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="UpdateSourceComboBox"
                                            Grid.Column="1"
                                            MinWidth="168"
                                            SelectionChanged="UpdateSourceComboBox_SelectionChanged"
                                            VerticalAlignment="Center">
                                            <ComboBoxItem Content="GitHub" />
                                            <ComboBoxItem Content="Gitee" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="更新通道" />
                                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding Settings.UpdateChannelText, Mode=OneWay}" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="UpdateChannelComboBox"
                                            Grid.Column="1"
                                            MinWidth="168"
                                            SelectionChanged="UpdateChannelComboBox_SelectionChanged"
                                            VerticalAlignment="Center">
                                            <ComboBoxItem Content="正式版" />
                                            <ComboBoxItem Content="测试版" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="自动检查更新" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" IsOn="{Binding Settings.UpdateAutoCheckEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="启动时后台检查" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" IsOn="{Binding Settings.UpdateCheckOnStartup, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="最长连接时间" />
                                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding Settings.UpdateConnectionTimeoutText, Mode=OneWay}" />
                                        </StackPanel>
                                        <NumberBox
                                            Grid.Column="1"
                                            AcceptsExpression="False"
                                            LargeChange="30"
                                            Maximum="600"
                                            Minimum="10"
                                            SmallChange="10"
                                            SpinButtonPlacementMode="Compact"
                                            ValidationMode="InvalidInputOverwritten"
                                            Value="{Binding Settings.UpdateConnectionTimeoutSeconds, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding Settings.UpdateLastCheckText, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding Settings.UpdateLastStatus, Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Click="CheckUpdateButton_Click" Content="检查更新" Style="{StaticResource PrimaryToolButtonStyle}" />
                                        <Button Click="TestUpdateConnectionButton_Click" Content="测试更新源连接" Style="{StaticResource PrimaryToolButtonStyle}" />
                                        <Button Click="OpenReleasePageButton_Click" Content="打开 Release 页面" Style="{StaticResource PrimaryToolButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <Expander
                                IsExpanded="True"
                                Visibility="{Binding DeveloperRelease.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <Expander.Header>
                                    <TextBlock FontWeight="SemiBold" Text="开发者发布中心" />
                                </Expander.Header>
                                <StackPanel Padding="16,8,16,16" Spacing="12">
                                    <InfoBar
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="{Binding DeveloperRelease.ConfigurationMessage, Mode=OneWay}"
                                        Severity="{Binding DeveloperRelease.ConfigurationSeverity, Mode=OneWay}"
                                        Title="{Binding DeveloperRelease.ConfigurationTitle, Mode=OneWay}" />
                                    <TextBox
                                        Header="开发者工程目录"
                                        IsReadOnly="True"
                                        Text="{Binding DeveloperRelease.ProjectRoot, Mode=OneWay}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Header="目标版本号"
                                            PlaceholderText="必须高于当前版本"
                                            Text="{Binding DeveloperRelease.TargetVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            Margin="0,28,0,0"
                                            Click="SuggestBetaVersionButton_Click"
                                            Content="测试版建议"
                                            Style="{StaticResource PrimaryToolButtonStyle}" />
                                        <Button
                                            Grid.Column="2"
                                            Margin="0,28,0,0"
                                            Click="SuggestStableVersionButton_Click"
                                            Content="正式版建议"
                                            Style="{StaticResource PrimaryToolButtonStyle}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding DeveloperRelease.CurrentVersionText, Mode=OneWay}" />
                                    <Grid ColumnSpacing="8" RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Click="PackStableDeveloperButton_Click"
                                            IsEnabled="{Binding DeveloperRelease.CanRun, Mode=OneWay}"
                                            Style="{StaticResource PrimaryToolButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <SymbolIcon Symbol="Save" />
                                                <TextBlock Text="打包正式版" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Grid.Column="1"
                                            Click="PackBetaDeveloperButton_Click"
                                            IsEnabled="{Binding DeveloperRelease.CanRun, Mode=OneWay}"
                                            Style="{StaticResource PrimaryToolButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <SymbolIcon Symbol="Save" />
                                                <TextBlock Text="打包测试版" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            Click="PublishLatestDeveloperButton_Click"
                                            IsEnabled="{Binding DeveloperRelease.CanRun, Mode=OneWay}"
                                            Style="{StaticResource PrimaryToolButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <SymbolIcon Symbol="Upload" />
                                                <TextBlock Text="发布最新包" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Row="1" Click="OpenDeveloperOutputRootButton_Click" Content="打开打包目录" Style="{StaticResource PrimaryToolButtonStyle}" />
                                        <Button Grid.Row="1" Grid.Column="1" Click="OpenDeveloperReleaseAssetsButton_Click" Content="打开发布资产" Style="{StaticResource PrimaryToolButtonStyle}" />
                                        <Button Grid.Row="1" Grid.Column="2" Click="RefreshDeveloperReleaseButton_Click" Content="刷新配置" Style="{StaticResource PrimaryToolButtonStyle}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="配置集" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Click="ConfigureDeveloperGitHubButton_Click" Content="GitHub 登录" Style="{StaticResource PrimaryToolButtonStyle}" />
                                        <Button Click="SetDeveloperGiteeTokenButton_Click" Content="设置 Gitee Token" Style="{StaticResource PrimaryToolButtonStyle}" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressRing
                                            Width="20"
                                            Height="20"
                                            IsActive="{Binding DeveloperRelease.IsBusy, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SubtleTextStyle}"
                                            Text="{Binding DeveloperRelease.OperationStatus, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <ListView
                                        MaxHeight="240"
                                        ItemsSource="{Binding DeveloperRelease.OutputLines, Mode=OneWay}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    FontFamily="Cascadia Mono"
                                                    FontSize="12"
                                                    Text="{Binding}"
                                                    TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Expander>

                            <Border Style="{StaticResource PanelBorderStyle}">
                                <StackPanel Padding="16" Spacing="12">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="危险操作" />
                                    <TextBlock Style="{StaticResource SubtleTextStyle}" Text="恢复推荐值不会删除旧目录，也不会删除用户制作数据。" />
                                    <Button HorizontalAlignment="Left" Click="RestoreRecommendedSettingsButton_Click" Content="恢复推荐值" Style="{StaticResource PrimaryToolButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource PanelBorderStyle}">
                            <StackPanel Padding="16" Spacing="12">
                                <Border Width="86" Height="86" CornerRadius="16" HorizontalAlignment="Left">
                                    <Image Source="ms-appx:///Assets/AppIcon.png" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" FontSize="20" />
                                    <TextBlock Text="幻杀工具箱" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding AboutVersionText, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>
                                <TextBlock Text="面向卡牌和三国杀类武将制作的工具箱，用于组织角色、手牌和 FantasyProject 虚幻同步流程。" Style="{StaticResource SubtleTextStyle}" />
                                <StackPanel Spacing="8">
                                    <TextBlock Text="版本命名" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="采用 主版本.功能版本.修订版本。1.0.0 表示当前进入第一个可维护基线版本。" Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="制作人员" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="企划 / 使用设计：柳雨" Style="{StaticResource SubtleTextStyle}" />
                                    <TextBlock Text="程序协作：Codex" Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Spacing="8">
                    <Border Padding="12" Style="{StaticResource PanelBorderStyle}" Visibility="{Binding Settings.ShowCurrentModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="CurrentModuleText"
                                Style="{StaticResource SubtleTextStyle}"
                                Text="角色：武将与角色卡的资料、立绘、技能和制作状态入口"
                                VerticalAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                Click="RefreshShellButton_Click"
                                Style="{StaticResource IconToolButtonStyle}"
                                ToolTipService.ToolTip="刷新当前工具箱状态">
                                <SymbolIcon Symbol="Refresh" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border Padding="12" Style="{StaticResource PanelBorderStyle}" Visibility="{Binding Settings.ShowWorkspacePath, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding Settings.WorkspaceStatusText, Mode=OneWay}" />
                    </Border>

                    <Border Padding="12" Style="{StaticResource PanelBorderStyle}" Visibility="{Binding Settings.LogEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="输出日志" />
                            <ListView Grid.Row="1" MaxHeight="160" ItemsSource="{Binding Settings.LogEntries, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="Consolas" FontSize="12" Text="{Binding Text}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </NavigationView>

        <Border
            x:Name="GlobalProgressHost"
            Grid.Row="1"
            MaxWidth="1540"
            Margin="28"
            Padding="22,18"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Canvas.ZIndex="320"
            Background="{ThemeResource GlobalProgressHostBackgroundBrush}"
            BorderBrush="{ThemeResource GlobalProgressHostBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Opacity="0"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="GlobalProgressHostTransform" Y="130" />
            </Border.RenderTransform>

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GlobalProgressPrimaryTextBrush}"
                            Text="当前进度:" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GlobalProgressPrimaryTextBrush}"
                            Text="{Binding GlobalProgress.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="2"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GlobalProgressPrimaryTextBrush}"
                            Text="用时:" />
                        <TextBlock
                            Grid.Column="3"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GlobalProgressPrimaryTextBrush}"
                            Text="{Binding GlobalProgress.ElapsedText, Mode=OneWay}" />
                    </Grid>

                    <ProgressBar
                        Grid.Row="1"
                        Height="11"
                        Minimum="0"
                        Maximum="100"
                        Foreground="#008F8D"
                        Background="#1A008F8D"
                        Value="{Binding GlobalProgress.Percent, Mode=OneWay}"
                        IsIndeterminate="{Binding GlobalProgress.IsIndeterminate, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="2"
                        Foreground="{ThemeResource GlobalProgressSecondaryTextBrush}"
                        Text="{Binding GlobalProgress.Detail, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid
                    x:Name="GlobalProgressRing"
                    Grid.Column="1"
                    Width="86"
                    Height="86"
                    Background="Transparent"
                    Tapped="GlobalProgressRing_Tapped"
                    ToolTipService.ToolTip="取消当前操作">
                    <Ellipse
                        Stroke="#22008F8D"
                        StrokeThickness="7" />
                    <Path
                        x:Name="GlobalProgressRingPath"
                        Stroke="#008F8D"
                        StrokeThickness="7"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="#008F8D"
                        LineHeight="28"
                        TextAlignment="Center"
                        Text="{Binding GlobalProgress.PercentText, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Border>

        <StackPanel
            x:Name="FloatingTipsPanel"
            Grid.Row="1"
            MaxWidth="520"
            Margin="0,18,28,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Canvas.ZIndex="330"
            Spacing="6" />

        <Popup
            x:Name="ImageCropPopup"
            IsLightDismissEnabled="False">
            <Grid
                x:Name="ImageCropHost"
                Background="#8C000000"
                IsTabStop="True"
                KeyDown="ImageCropHost_KeyDown"
                RightTapped="ImageCropHost_RightTapped"
                Visibility="Collapsed">
                <Grid.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="18" />
                    </TransitionCollection>
                </Grid.Transitions>
                <Border
                    Width="760"
                    MaxHeight="700"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="30,24,30,14" Spacing="4">
                            <TextBlock
                                x:Name="ImageCropTitleText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="裁剪图片" />
                            <TextBlock
                                x:Name="ImageCropSubtitleText"
                                Style="{StaticResource SubtleTextStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="30,0,30,24">
                            <Border
                                x:Name="ImageCropPreviewFrame"
                                Width="460"
                                Height="460"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#202020"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                DoubleTapped="ImageCropPreviewFrame_DoubleTapped"
                                PointerCanceled="ImageCropPreviewFrame_PointerCanceled"
                                PointerCaptureLost="ImageCropPreviewFrame_PointerCaptureLost"
                                PointerMoved="ImageCropPreviewFrame_PointerMoved"
                                PointerPressed="ImageCropPreviewFrame_PointerPressed"
                                PointerReleased="ImageCropPreviewFrame_PointerReleased"
                                PointerWheelChanged="ImageCropPreviewFrame_PointerWheelChanged"
                                RightTapped="ImageCropPreviewFrame_RightTapped">
                                <Grid>
                                    <Image
                                        x:Name="ImageCropImage"
                                        HorizontalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5"
                                        Stretch="Fill"
                                        VerticalAlignment="Center">
                                        <Image.RenderTransform>
                                            <CompositeTransform x:Name="ImageCropImageTransform" />
                                        </Image.RenderTransform>
                                    </Image>
                                    <Grid IsHitTestVisible="False">
                                        <Rectangle
                                            x:Name="ImageCropMaskTop"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            Fill="#80000000" />
                                        <Rectangle
                                            x:Name="ImageCropMaskBottom"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Bottom"
                                            Fill="#80000000" />
                                        <Rectangle
                                            x:Name="ImageCropMaskLeft"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Fill="#80000000" />
                                        <Rectangle
                                            x:Name="ImageCropMaskRight"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Fill="#80000000" />
                                    </Grid>
                                    <Border
                                        x:Name="ImageCropTargetFrame"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        BorderBrush="#F2FFFFFF"
                                        BorderThickness="2"
                                        CornerRadius="2"
                                        IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Border
                            Grid.Row="2"
                            Padding="30,18"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Click="ImageCropConfirmButton_Click"
                                    Content="确定裁剪"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource DialogAccentButtonStyle}" />
                                <Button
                                    Grid.Column="1"
                                    Click="ImageCropCancelButton_Click"
                                    Content="取消"
                                    HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</Window>
