<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GlobalProgressHostBackgroundBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="GlobalProgressHostBorderBrush" Color="#33000000" />
            <SolidColorBrush x:Key="GlobalProgressPrimaryTextBrush" Color="#202020" />
            <SolidColorBrush x:Key="GlobalProgressSecondaryTextBrush" Color="#99000000" />
            <SolidColorBrush x:Key="SuitDeckFilledBackgroundBrush" Color="#EAF7F1" />
            <SolidColorBrush x:Key="SuitDeckFilledBorderBrush" Color="#2E9D73" />
            <SolidColorBrush x:Key="SuitDeckFilledAccentBrush" Color="#168765" />
            <SolidColorBrush x:Key="SuitDeckFilledTextBrush" Color="#064D39" />
            <SolidColorBrush x:Key="SuitDeckMissingBackgroundBrush" Color="#FFF7E8" />
            <SolidColorBrush x:Key="SuitDeckMissingBorderBrush" Color="#C87900" />
            <SolidColorBrush x:Key="SuitDeckMissingAccentBrush" Color="#C87900" />
            <SolidColorBrush x:Key="SuitDeckMissingTextBrush" Color="#6B3D00" />
            <SolidColorBrush x:Key="HandCardSuitTextStrokeBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="HandCardAddBackgroundBrush" Color="#F1F1F1" />
            <SolidColorBrush x:Key="HandCardHeartsBackgroundBrush" Color="#FFE0E5" />
            <SolidColorBrush x:Key="HandCardDiamondsBackgroundBrush" Color="#FFE6C2" />
            <SolidColorBrush x:Key="HandCardClubsBackgroundBrush" Color="#D3F4EF" />
            <SolidColorBrush x:Key="HandCardSpadesBackgroundBrush" Color="#D8E9FF" />
            <SolidColorBrush x:Key="HandCardHeartsTextBrush" Color="#B20F2A" />
            <SolidColorBrush x:Key="HandCardDiamondsTextBrush" Color="#B85A00" />
            <SolidColorBrush x:Key="HandCardClubsTextBrush" Color="#006F67" />
            <SolidColorBrush x:Key="HandCardSpadesTextBrush" Color="#124CA6" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="GlobalProgressHostBackgroundBrush" Color="#F0000000" />
            <SolidColorBrush x:Key="GlobalProgressHostBorderBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="GlobalProgressPrimaryTextBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="GlobalProgressSecondaryTextBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="SuitDeckFilledBackgroundBrush" Color="#132F27" />
            <SolidColorBrush x:Key="SuitDeckFilledBorderBrush" Color="#4FC89C" />
            <SolidColorBrush x:Key="SuitDeckFilledAccentBrush" Color="#20906F" />
            <SolidColorBrush x:Key="SuitDeckFilledTextBrush" Color="#B7F2DC" />
            <SolidColorBrush x:Key="SuitDeckMissingBackgroundBrush" Color="#362817" />
            <SolidColorBrush x:Key="SuitDeckMissingBorderBrush" Color="#E1A33A" />
            <SolidColorBrush x:Key="SuitDeckMissingAccentBrush" Color="#B97716" />
            <SolidColorBrush x:Key="SuitDeckMissingTextBrush" Color="#FFD89A" />
            <SolidColorBrush x:Key="HandCardSuitTextStrokeBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="HandCardAddBackgroundBrush" Color="#3A3838" />
            <SolidColorBrush x:Key="HandCardHeartsBackgroundBrush" Color="#4B1821" />
            <SolidColorBrush x:Key="HandCardDiamondsBackgroundBrush" Color="#4A2E11" />
            <SolidColorBrush x:Key="HandCardClubsBackgroundBrush" Color="#113F3B" />
            <SolidColorBrush x:Key="HandCardSpadesBackgroundBrush" Color="#143762" />
            <SolidColorBrush x:Key="HandCardHeartsTextBrush" Color="#FF5E78" />
            <SolidColorBrush x:Key="HandCardDiamondsTextBrush" Color="#FF9D3D" />
            <SolidColorBrush x:Key="HandCardClubsTextBrush" Color="#27CABD" />
            <SolidColorBrush x:Key="HandCardSpadesTextBrush" Color="#66AAFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
    </Style>

    <Style x:Key="ToolbarBorderStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MetricTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="IconToolButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="CompactIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconToolButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style x:Key="HelpIconButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactIconButtonStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="PrimaryToolButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="SecondaryBreadcrumbButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DialogAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="ToolCardStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="MinHeight" Value="108" />
    </Style>

    <Style x:Key="ObjectCardStyle" TargetType="Button">
        <Setter Property="Width" Value="220" />
        <Setter Property="Height" Value="220" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="ObjectCardMediaStyle" TargetType="Border">
        <Setter Property="Height" Value="118" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{ThemeResource LayerFillColorAltBrush}" />
    </Style>

    <Style x:Key="StandardPlayingCardButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="146.4" />
        <Setter Property="Height" Value="220.8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="StandardPlayingCardFrameStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
        <Setter Property="Width" Value="132" />
        <Setter Property="Height" Value="185.4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="StandardPlayingCardMediaStyle" TargetType="Border">
        <Setter Property="Width" Value="132" />
        <Setter Property="Height" Value="185.4" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource LayerFillColorAltBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="StatusPillBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCautionBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="Expander">
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
</ResourceDictionary>
